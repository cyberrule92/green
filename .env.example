# ── Core API ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080
PUBLIC_HOSTNAME=
TRITON_TIMEOUT_SECONDS=45
TRITON_READY_WAIT_SECONDS=60
HF_TOKEN=hf_your_token_here
DISABLE_GPU_METRICS=1

# ── Triton model endpoint names ───────────────────────────────────────────
# These MUST match the directory names inside model_repository/.
# Defaults: small_model / medium_model / large_model (generic names).
# Set these if your Triton model directories use different names, e.g.:
#   TRITON_FULL_MODEL=Qwen2-1.5B-Instruct
#   TRITON_MEDIUM_MODEL=TinyLlama-1.1B-Chat-v1.0
TRITON_ULTRA_LIGHT_MODEL=small_model
TRITON_MEDIUM_MODEL=medium_model
TRITON_FULL_MODEL=large_model
TRITON_MOE_MODEL=large_model

# ── GPU power envelope (affects GPU CO₂ attribution) ─────────────────────
# GPU_TDP: thermal design power of your GPU in watts
#   A100=400, V100=300, RTX3090=350, T4=70, RTX4090=450
GPU_TDP=350
# GPU_VRAM_GB: total VRAM in GB (used for GPU util estimation when hw=0)
GPU_VRAM_GB=16


# ── Context and attachment limits ────────────────────────────────────────
MAX_CONTEXT_CHARS=15000
MAX_ATTACHMENT_BYTES=8388608
MAX_ATTACHMENT_EXTRACT_CHARS=12000
MAX_ATTACHMENTS_PER_MESSAGE=6

# ── RAG configuration ────────────────────────────────────────────────────
DEFAULT_RAG_TOP_K=6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_DENSE_TOP_K=14
RAG_RERANK_TOP_K=8
RAG_CONTEXT_CHAR_LIMIT=5200
RAG_HASH_EMBED_DIM=256
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Grid Carbon Fetcher — Electricity Maps (Section 3.2.2) ───────────────
# Get a free token at https://api.electricitymap.org
EMAP_TOKEN=your_electricitymaps_token_here
# Primary zone (default IN-WE = India West). Examples: US-CAL-CISO, DE, GB, FR
EMAP_ZONE=IN-WE
# Cache duration in seconds
EMAP_CACHE_SECONDS=60
# Forecast horizon in hours (paper requires 48)
EMAP_FORECAST_HOURS=48
# Additional zones for multi-region routing (Section 3.5.3)
# Format: ZONE_ID:region_key  comma-separated
EMAP_EXTRA_ZONES=US-CAL-CISO:us-west,DE:eu
# Fallback carbon intensity when Electricity Maps is unavailable (gCO2/kWh)
GRID_CARBON_FALLBACK=475

# ── Multi-region routing (Section 3.5.3) ────────────────────────────────
# Set to true to fetch zone signals for all EMAP_EXTRA_ZONES on each request
MULTI_REGION_ENABLED=false

# ── Audit trail HMAC key (Section 3.6.1) — REQUIRED IN PRODUCTION ──────
# In ENV=production the API refuses to start without this set. Generate a
# fresh secret (e.g. `openssl rand -hex 32`) and store it in your secrets
# manager. The literal string "green-ai-audit-key-change-in-production" is
# explicitly rejected.
# AUDIT_HMAC_KEY=
# ENV=production            # uncomment in prod to enforce HMAC requirement

# ── vLLM endpoints (paper §3.3) ─────────────────────────────────────────
# The default 2-container stack only needs MEDIUM + FULL. The other URLs
# default to FULL and are only consulted when the matching docker-compose
# profile (--profile moe / stem / fallback) brings up a dedicated container.
VLLM_MEDIUM_URL=http://127.0.0.1:8001/v1
VLLM_FULL_URL=http://127.0.0.1:8002/v1
# VLLM_MOE_URL=http://127.0.0.1:8003/v1
# VLLM_STEM_MATH_URL=http://127.0.0.1:8004/v1
# VLLM_STEM_SCIENCE_URL=http://127.0.0.1:8005/v1
# VLLM_STEM_CODING_URL=http://127.0.0.1:8006/v1
# VLLM_FALLBACK_URL=http://127.0.0.1:8007/v1
VLLM_TIMEOUT_SECONDS=45

# ── FT-MoE reconciler (paper §5.3) ──────────────────────────────────────
MOE_RECONCILER_ENABLED=true
MOE_RECONCILER_INTERVAL_S=10
MOE_RECONCILER_REBALANCE_RATIO=0.75
MOE_RECONCILER_DISABLE_RATIO=0.5

# ── Model Zoo (Section 3.3) ──────────────────────────────────────────────
MODEL_ZOO_PATH=config/model_zoo.json

# ── Deferred Queue (Section 3.5.2) ──────────────────────────────────────
# Carbon threshold above which deferral is considered (gCO2/kWh)
HIGH_CARBON_THRESHOLD=450
# Background dispatch check interval in seconds
DISPATCH_INTERVAL_S=10
# Maximum deferred items in queue
MAX_QUEUE_SIZE=500

# ── Routing semantic model ───────────────────────────────────────────────
ROUTING_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Data paths ───────────────────────────────────────────────────────────
DECISION_LOG_PATH=data/decision_logs.jsonl
CONVERSATION_STORE_PATH=data/green_ai.db
RAG_STORE_PATH=data/rag_store.json
POLICY_CONFIG_PATH=config/policies.json
# routing_targets.json removed — model_zoo.json is now the single source of truth

# ── RL Policy Controller (Decision-based-on-RL) ──────────────────────────
# State persisted automatically — no manual configuration needed at runtime
RL_STATE_PATH=data/rl_state.json
RL_ALPHA_0=0.06
RL_BASELINE_BETA=0.95
RL_SOFTMAX_TEMP=0.25
RL_DIRICHLET_ALPHA=0.3
RL_DIRICHLET_EPSILON=0.15
RL_W_MIN=0.05
RL_EXPLORATION=true
RL_CONVERGENCE_WINDOW=50
RL_CONVERGENCE_TOL=0.005
RL_REWARD_LAMBDA_SLA=0.35
RL_REWARD_LAMBDA_CARBON=0.30
RL_REWARD_LAMBDA_ACCURACY=0.25
RL_REWARD_LAMBDA_COST=0.10
RL_CARBON_REF_G=0.05

# ── Learned quality/latency estimator (feeds CSS accuracy/latency only) ──
# Refines the STATIC per-model accuracy/latency baselines that feed the CSS
# accuracy_score and latency_score with a per-prompt correction learned online
# from observed outcomes. Carbon (op + embodied) is NEVER adjusted here, so the
# greenest-feasible invariant is preserved. Cold-start = identity: weights start
# at zero (Δaccuracy=0, latency_scale=1) so a fresh deployment routes exactly as
# the static-baseline system until it has observed traffic. Set to false to pin
# routing to the static baselines. State persists automatically.
QL_ESTIMATOR_ENABLED=true
QL_ESTIMATOR_STATE_PATH=data/ql_estimator_state.json
QL_ESTIMATOR_LR=0.02
QL_ESTIMATOR_L2=0.001
# Per-variant observations required before its predictions are trusted (below
# this the estimator returns baselines).
QL_ESTIMATOR_WARMUP=8
# Conservative clamps bounding the estimator's influence on CSS.
QL_ESTIMATOR_ACC_CLAMP=0.15
QL_ESTIMATOR_LAT_MIN=0.6
QL_ESTIMATOR_LAT_MAX=2.5

# ── Multimodal: image analysis (VLM) + image generation (diffusion) ──────
# NVIDIA NIM endpoints. Unset → the router still accepts image analysis/
# generation requests and returns a clearly-labelled placeholder (graceful
# fallback), so the full carbon-aware pipeline runs today; set these to the
# deployed NIM base URLs to enable real inference.
#   VLM (image analysis):        NVIDIA Nemotron Nano V2 VL
#   Diffusion (image generation): SDXL (fast) and FLUX.1 (high quality)
NIM_VLM_URL=
NIM_SDXL_URL=
NIM_FLUX_URL=
# Best-effort call timeouts (seconds); a slow NIM falls back rather than stalling.
NIM_CONNECT_TIMEOUT=3
NIM_READ_TIMEOUT=60
# Real-image fallback when no NIM diffusion endpoint is set: generate via a hosted
# Hugging Face text-to-image model (uses HF_TOKEN above; no local torch/GPU).
# Only if this ALSO fails do we return a labelled SVG placeholder.
#
# The model is NOT a free choice. The hf-inference provider serves a small and
# shrinking set of text-to-image models, and asking for one it has dropped
# returns HTTP 410 — which becomes a placeholder with no visible cause. On
# 2026-07-30 FLUX.1-schnell (the previous default here) started 410-ing and every
# generated image silently became a placeholder. Check what is actually served
# before changing this:
#   https://huggingface.co/api/models?pipeline_tag=text-to-image&inference_provider=hf-inference
HF_IMAGE_FALLBACK_ENABLED=true
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# Optional per-variant overrides. Both diffusion rungs resolve to the same
# upstream model unless these are set, because the provider serves only one —
# the response reports the model that actually ran, not the candidate's name.
# HF_SDXL_MODEL=
# HF_FLUX_MODEL=
# Ceiling on denoising steps sent upstream. Keep it at or above the zoo's largest
# diffusion_min_steps, or it pins every request to one value and the carbon-aware
# step ramp (30 → 10 as grid intensity rises) stops having any effect.
# HF_IMAGE_MAX_STEPS=28
HF_IMAGE_MAX_STEPS=8
HF_READ_TIMEOUT=120
# Grid carbon (gCO2/kWh) above which image generation trims its denoising-step
# budget toward the model floor — the biggest per-request carbon lever for gen.
DIFFUSION_HIGH_CARBON_CI=400.0

# ── Per-zone RL specialisation ──────────────────────────────────────────
# When enabled, each grid zone learns its own bounded weight bucket on top of
# the per-tier global policy. A zone bucket only takes over once it has
# accumulated RL_ZONE_MIN_EPISODES observations; until then the tier policy
# is used. Weights remain on the same simplex (RL_W_MIN floor).
RL_ZONE_LEARNING=true
RL_ZONE_MIN_EPISODES=20
# Grid-quality reward: rewards picking a greener-than-average candidate when
# the live grid is dirty (≥ RL_GRID_DIRTY_THRESHOLD gCO2/kWh). 0 disables.
# Hard-capped to 0.25 internally so it cannot dominate the other components.
RL_REWARD_LAMBDA_GRID_QUALITY=0.0
RL_GRID_DIRTY_THRESHOLD=500.0

# ── Model Zoo auto-updater (off by default; requires human approval) ────
# When enabled, the updater polls a trusted source for new model_zoo entries,
# validates them against the schema + bounds, and stages them in
# config/model_zoo_pending.json. Nothing ever applies automatically — entries
# must be approved via POST /api/model-zoo/updates/{id}/approve (admin-gated).
MODEL_ZOO_UPDATE_ENABLED=false
# Exact URL of the trusted source (https:// or file://). Must match exactly.
MODEL_ZOO_UPDATE_SOURCE=
MODEL_ZOO_UPDATE_INTERVAL_S=3600
MODEL_ZOO_UPDATE_TIMEOUT_S=20
MODEL_ZOO_PENDING_PATH=config/model_zoo_pending.json
MODEL_ZOO_UPDATE_AUDIT=data/model_zoo_updates.jsonl

# ── Secrets at rest ─────────────────────────────────────────────────────
# Key for the stdlib secret box (currently HF_TOKEN_ENC). Falls back to
# AUDIT_HMAC_KEY when unset; in dev that key is ephemeral per process, so
# encrypted values will not decrypt after a restart. Set a durable key in
# production. WF_SECRET_KEY is still read as a legacy alias.
# SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Model onboarding (/api/models)
#
# Browse Hugging Face, size a quantization plan against real headroom, download,
# serve and register new routing candidates. Exists because the three-arm
# measurement showed the ladder has no genuinely cheaper rung — quantization is
# how real rungs get added.
#
# An onboarded model is registered `available: false` and CSS cannot select it
# until measured accuracy/latency are posted to /api/models/{id}/measure. That
# gate is the point of the feature, not a limitation of it.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Browsing and plan preview work while this is false; nothing is
# downloaded, served or registered.
MODEL_ONBOARD_ENABLED=false

# Encrypted HF token, preferred over the plaintext HF_TOKEN above. Produced with
# the stdlib secret box (SECRET_KEY, falling back to the audit key).
# Set this instead of HF_TOKEN in production.
# HF_TOKEN_ENC=

# Safety margins. VRAM is the binding constraint on a shared vGPU slice: the
# planner refuses a model whose estimate exceeds (free VRAM - reserve). Note the
# probe reads the MIG *instance* capacity where MIG is enabled, not the board's
# — on an H100L-2-24C those differ by ~3 GB and the board figure over-promises.
#
# GPU occupancy is read from `nvidia-smi` where available, else from the host
# metrics sidecar's system_gpu_* fields. Both unavailable (the default: the API
# image has no nvidia-smi and system_metrics.sh ships DISABLE_GPU_METRICS=1)
# means the planner REFUSES to size rather than assuming the slice is empty.
# Enable GPU metrics on the host-run sidecar to make onboarding usable; adding
# GPU access to the API container does not help on a MIG board, where
# in-container memory queries return "[Insufficient Permissions]".
MODEL_ONBOARD_VRAM_RESERVE_MB=1024
MODEL_ONBOARD_DISK_RESERVE_GB=20
# Non-KV runtime headroom (CUDA graphs, activations, allocator slack). Raise it
# if loads OOM during warm-up rather than at load.
# MODEL_ONBOARD_OVERHEAD_MB=1024

# Where onboarding job history is persisted.
# MODEL_ONBOARD_STATE_PATH=data/model_onboarding.json

# trust_remote_code executes arbitrary Python from the model repo at load time.
# Refused unless this is deliberately true, and it must still be requested
# per-model on the onboarding call.
MODEL_ONBOARD_ALLOW_TRUST_REMOTE_CODE=false

# ── Dynamic serving ─────────────────────────────────────────────────────────
# Launching a vLLM container for an onboarded model needs the Docker socket
# bind-mounted into the API container. That is root-equivalent control of the
# host, so it is opt-in and NOT in the default compose stack — see
# docker-compose.onboarding.yml. Without it, onboarding still downloads and
# registers; only the serve step reports itself unavailable.
DOCKER_SOCKET=/var/run/docker.sock
MODEL_SERVE_IMAGE=vllm/vllm-openai:latest
# Must be the compose network the API and vLLM containers share.
MODEL_SERVE_NETWORK=green_default
# Container-internal ports only; nothing is published to the host.
MODEL_SERVE_PORT_BASE=8010
# Host path of the shared HF cache, bind-mounted into served containers.
HF_CACHE_HOST_PATH=/opt/green/data/hf-cache

# ── Local quantization (opt-in, metered) ────────────────────────────────────
# Only used when no pre-quantized checkpoint exists upstream AND the caller asks
# for it explicitly. An AWQ/GPTQ calibration pass is the most carbon-expensive
# operation this system performs and it contends with live traffic for the same
# GPU, so prefer a pre-quantized repo from the hub — that carbon was already
# paid by someone else.
#
# The runner now ships: docker/quantize/Dockerfile builds green-quantize:latest
# (vLLM image + autoawq, so no second torch), carrying scripts/quantize_awq.py.
# Build it before enabling:
#   docker build -f docker/quantize/Dockerfile -t green-quantize:latest .
# Left unset, the capability reports itself unavailable with a reason rather than
# pretending to work. {repo_id} and {out_dir} are substituted.
MODEL_QUANT_IMAGE=green-quantize:latest
MODEL_QUANT_COMMAND=python3 /opt/green/quantize_awq.py --repo-id {repo_id} --out-dir {out_dir}
# Hardware efficiency divisor used when metering the pass's energy.
# QUANT_HARDWARE_EFFICIENCY=0.75
#
# AWQ fits its scales to whatever it calibrates on, so a generic web-text slice
# makes the model generically good and a corpus of this deployment's own traffic
# makes it good here. Point this at a JSONL export (/api/feedback/export) to
# calibrate in-domain; unset falls back to the Pile slice, and the manifest
# records which was used.
# QUANT_CALIB_FILE=

# ── Quantize without onboarding ─────────────────────────────────────────────
# POST /api/models/quantize runs the same pipeline with the registration step
# skipped: the checkpoint is produced and can be downloaded from
# GET /api/models/artifacts/{id}/download, but nothing enters the model zoo and
# CSS never sees it. Quantizing a model and adding a rung to this deployment's
# ladder are separate decisions. Artifacts land under HF_CACHE_HOST_PATH
# /quantized/{id} and are listed by GET /api/models/artifacts.

# ─────────────────────────────────────────────────────────────────────────────
# Fine-tuning (/api/finetune, LoRA/QLoRA)
#
# The counterpart to onboarding: rather than importing a better rung, make the
# small one good enough at this deployment's traffic that the router stops
# escalating. Training data comes from up-voted feedback (/api/feedback).
#
# Training SPENDS carbon — it is the largest single compute event here. Every
# job is metered against measured wall-clock with grid intensity sampled during
# the run, and the result is only worth it if the adapter lets the router serve
# on a cheaper rung; estimate_payback turns the one-off into requests-to-break-even.
# ─────────────────────────────────────────────────────────────────────────────

FINETUNE_ENABLED=false

# Trainer image + command. The API image cannot train at all — its torch targets
# CUDA 13 against a 12.8 driver and fails to initialise CUDA, and peft/trl are
# absent. docker/finetune/Dockerfile builds the runner from the vLLM image
# (whose torch is the one proven to open a CUDA context here) plus peft, trl and
# datasets; bitsandbytes and accelerate are already in that base, and 4-bit was
# verified working on this GPU. Build it before enabling:
#   docker build -f docker/finetune/Dockerfile -t green-finetune:latest .
# Unset -> capability reports unavailable rather than pretending. Substituted:
# {base_repo} {dataset} {out_dir} {method} {lora_rank} {epochs}
MODEL_FINETUNE_IMAGE=green-finetune:latest
MODEL_FINETUNE_COMMAND=python3 /opt/green/finetune_train.py --base-repo {base_repo} --dataset {dataset} --out-dir {out_dir} --method {method} --lora-rank {lora_rank} --epochs {epochs}

# Carbon-aware scheduling. Above this grid intensity the job waits for the
# cleanest window in the forecast instead of starting now — nobody is blocked on
# a training run, which is what makes the deferral free.
FINETUNE_DEFER_CI=300
FINETUNE_LOOKAHEAD_H=48
# Give up waiting and just run, rather than deferring indefinitely.
FINETUNE_MAX_WAIT_S=172800
FINETUNE_WINDOW_POLL_S=300
# How often grid intensity is sampled during a run, for integrated carbon.
FINETUNE_CI_SAMPLE_S=300
FINETUNE_TIMEOUT_S=86400
FINETUNE_HARDWARE_EFFICIENCY=0.75

# Where datasets and adapters live. The _HOST path is passed to the Docker API
# as a bind source, so the daemon resolves it on the host, not in the container.
# FINETUNE_STATE_PATH=data/finetuning.json
# FINETUNE_WORK_DIR=data/finetune
# FINETUNE_WORK_DIR_HOST=/opt/green/data/finetune
